{
  "name": "saveme",
  "productName": "SaveMe",
  "version": "0.1.0",
  "description": "Automatic game save backup to Google Drive and OneDrive",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "koffi": "^2.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@2.16.3": true,
    "electron-winstaller@5.4.0": true
  }
}
