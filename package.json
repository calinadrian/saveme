{
  "name": "saveme",
  "productName": "SaveMe",
  "version": "0.1.3",
  "description": "Automatic game save backup to Google Drive, OneDrive or any folder",
  "author": {
    "name": "calinadrian",
    "email": "hassian.inbox@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://calinadrian.github.io/saveme/",
  "repository": {
    "type": "git",
    "url": "https://github.com/calinadrian/saveme.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "licenses": "node scripts/licenses.mjs",
    "dev": "npm run licenses && electron-vite dev",
    "build": "npm run icons && npm run licenses && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.11",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "koffi": "^2.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@2.16.3": true,
    "electron-winstaller@5.4.0": true
  }
}
